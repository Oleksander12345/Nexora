{
  "name": "elec-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch-path=server --watch-path=src/domain --watch-path=src/application server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && npm run serve",
    "serve": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:e2e": "node e2e/smoke.mjs",
    "format": "prettier --write src server tests scripts e2e index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src server tests scripts e2e index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.13.13",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.56.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
